meta {
  name: SOAPSearch - SucheAktenplaneintragMitDfV (als FH)
  type: http
  seq: 9
}

post {
  url: https://eakte26-k2-authldap.muenchen.de/fsc/fscdav/wsdl?WEBSVC=FSCGOVXML_1_1001_DefaultWebServiceDefinition
  body: xml
  auth: basic
}

params:query {
  WEBSVC: FSCGOVXML_1_1001_DefaultWebServiceDefinition
}

headers {
  Content-Type: text/xml; charset=utf-8
  SOAPAction: http://schemas.fabasoft.com/object/FSCBAI_1_1001_SOAPSearch
}

auth:basic {
  username: frank.hofmann1
  password: {{fh-password}}
}

body:xml {
  <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:fsc="http://schemas.fabasoft.com/websvc/FSCGOVXML_1_1001_DefaultWebServiceDefinition/" xmlns:urn="urn:schemas-fabasoft-com:bai:search">
     <soapenv:Body>
        <urn:SOAPSearchRequest>
        <!--
        lese Vorgänge, die einer bestimten Objektkategorie zugehören (=zugeordnetes Formular)
  	 -->
  	 <!--
  	 Bedingung für Zugehörigkeit zu bestimmtem Formular:
  	 .COOTC@1.1001:objcategory = "COO.2150.8800.1.291241"
  	 
  	 lhmdfvpublic@2150.8800:fhattr1 = "text 1"
  
        Bedingung mit normalem Metadateum funktioniert
  	         AND
  	           .COOSYSTEM@1.1:objname = "060-5/1 (Fh erster Vorgang)"
  
         mit Verfahrensdatum nicht:
  	         AND
  	           .lhmdfvpublic@2150.8800:fhattr1 = "text 1"
  	 -->
           <urn:query>
                NOCHECK
  	         SELECT *
  	         FROM COOELAK@1.1001:SubjectArea 
  	         WHERE
  	           .EGOVTEMPLATE@15.1001:availabledefinitions IS NOT NULL
           </urn:query>
           <urn:attrlist>
              <urn:attr>COOSYSTEM@1.1:objname</urn:attr>
   
              <urn:attr>EGOVTEMPLATE@15.1001:availabledefinitions.COOSYSTEM@1.1:objname</urn:attr>
              <urn:attr>EGOVTEMPLATE@15.1001:availabledefinitions.COOSYSTEM@1.1:objaddress</urn:attr>
              <urn:attr>EGOVTEMPLATE@15.1001:availabledefinitions.EGOVTEMPLATE@15.1001:availabledefinitions.COOSYSTEM@1.1:objname</urn:attr>
              <urn:attr>EGOVTEMPLATE@15.1001:availabledefinitions.EGOVTEMPLATE@15.1001:availabledefinitions.COOSYSTEM@1.1:objaddress</urn:attr>
              
            
           </urn:attrlist>
        </urn:SOAPSearchRequest>
     </soapenv:Body>
  </soapenv:Envelope>
}
