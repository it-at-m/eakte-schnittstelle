meta {
  name: SOAPSearch - suche Formulare
  type: http
  seq: 6
}

post {
  url: https://eakte26-k2-authldap.muenchen.de/fsc/fscdav/wsdl?WEBSVC=FSCGOVXML_1_1001_DefaultWebServiceDefinition
  body: xml
  auth: basic
}

params:query {
  WEBSVC: FSCGOVXML_1_1001_DefaultWebServiceDefinition
}

headers {
  Content-Type: text/xml; charset=utf-8
  SOAPAction: http://schemas.fabasoft.com/object/FSCBAI_1_1001_SOAPSearch
}

auth:basic {
  username: frank.hofmann1
  password: {{fh-password}}
}

body:xml {
  <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" 
     xmlns:fsc="http://schemas.fabasoft.com/websvc/FSCGOVXML_1_1001_DefaultWebServiceDefinition/" 
     xmlns:urn="urn:schemas-fabasoft-com:bai:search">
     <soapenv:Body>
        <urn:SOAPSearchRequest>
           <urn:query>
             SELECT *
             FROM FSCUSERFORMS@1.1001:UserForm
             WHERE .COOSYSTEM@1.1:objname like 'FH%'
           </urn:query>
           <urn:attrlist>
              <urn:attr>COOSYSTEM@1.1:objname</urn:attr>
              <urn:attr>COOSYSTEM@1.1:objaddress</urn:attr>
              <urn:attr>FSCUSERFORMS@1.1001:baseclass.COOSYSTEM@1.1:objname</urn:attr>
              <urn:attr>FSCUSERFORMS@1.1001:releasecategory</urn:attr>
              <urn:attr>FSCUSERFORMS@1.1001:releasecategory.COOSYSTEM@1.1:objname</urn:attr>
              <urn:attr>FSCUSERFORMS@1.1001:releasecategory.COOSYSTEM@1.1:objaddress</urn:attr>
           </urn:attrlist>
        </urn:SOAPSearchRequest>
     </soapenv:Body>
  </soapenv:Envelope>
}
