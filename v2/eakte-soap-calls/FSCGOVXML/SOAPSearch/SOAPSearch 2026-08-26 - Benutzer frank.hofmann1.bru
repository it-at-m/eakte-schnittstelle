                  <urn:attr>COOSYSTEM@1.1:userroles.COOSYSTEM@1.1:userrolegroup.COOSYSTEM@1.1:objname</urn:attr>
                  <urn:attr>COOSYSTEM@1.1:userroles.COOSYSTEM@1.1:userrolegroup.COOSYSTEM@1.1:objaddress</urn:attr>
                  <urn:attr>COOSYSTEM@1.1:userroles.COOSYSTEM@1.1:default</urn:attr>
