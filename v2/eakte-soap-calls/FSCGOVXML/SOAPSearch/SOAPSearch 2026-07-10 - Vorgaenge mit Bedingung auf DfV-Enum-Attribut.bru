meta {
  name: SOAPSearch 2026-07-10 - Vorgänge mit Bedingung auf DfV-Enum-Attribut
  type: http
  seq: 3
}

post {
  url: https://eakte26-k2-authldap.muenchen.de/fsc/fscdav/wsdl?WEBSVC=FSCGOVXML_1_1001_DefaultWebServiceDefinition
  body: xml
  auth: inherit
}

params:query {
  WEBSVC: FSCGOVXML_1_1001_DefaultWebServiceDefinition
}

headers {
  Content-Type: text/xml; charset=utf-8
  SOAPAction: http://schemas.fabasoft.com/object/FSCBAI_1_1001_SOAPSearch
}

body:xml {
  <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:fsc="http://schemas.fabasoft.com/websvc/FSCGOVXML_1_1001_DefaultWebServiceDefinition/" xmlns:urn="urn:schemas-fabasoft-com:bai:search">
     <soapenv:Body>
        <urn:SOAPSearchRequest>
           <urn:query>
             NOCHECK
  	         SELECT *
  	         FROM DEPRECONFIG@15.1001:Procedure 
  	         WHERE
  	           .lhmdfvpublic@2150.8800:DfV_parties IN (1, 7)
           </urn:query>
           <urn:attrlist>
              <urn:attr>COOELAK@1.1001:referrednumber.address</urn:attr>
              <urn:attr>COOELAK@1.1001:objmlname.langstring</urn:attr>
              <urn:attr>FSCFOLIO@1.1001:objdocstate</urn:attr>
              <urn:attr>FSCFOLIO@1.1001:bostate.name</urn:attr>
              <urn:attr>COOSYSTEM@1.1:objowngroup.name</urn:attr>
              <urn:attr>COOELAK@1.1001:filesubj</urn:attr>
              <urn:attr>COOELAK@1.1001:inchargeremark</urn:attr>
              <urn:attr>COOELAK@1.1001:filetype</urn:attr>
              <urn:attr>FSCTERM@1.1001:objterms</urn:attr>
              <urn:attr>FSCFOLIO@1.1001:objaccdef</urn:attr>
              <urn:attr>DEPRECONFIG@15.1001:fileruntimefrom</urn:attr>
              <urn:attr>DEPRECONFIG@15.1001:fileruntimetill</urn:attr>
              <urn:attr>lhmdfvpublic@2150.8800:DfV_parties</urn:attr>
           </urn:attrlist>
        </urn:SOAPSearchRequest>
     </soapenv:Body>
  </soapenv:Envelope>
}
