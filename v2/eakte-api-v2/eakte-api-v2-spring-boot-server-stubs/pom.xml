<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.muenchen.oss.eakte</groupId>
    <artifactId>eakte-api-v2</artifactId>
    <version>2.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>eakte-api-v2-spring-boot-server-stubs</artifactId>

  <properties>
    <java.version>21</java.version>

    <spring-boot.version>4.1.0</spring-boot.version>
    <jackson-databind-nullable.version>0.2.11</jackson-databind-nullable.version>
    <swagger-annotation.version>2.2.55</swagger-annotation.version>

    <!-- Build Plugins -->
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-dependency-plugin.version>3.6.1</maven-dependency-plugin.version>
    <openapi-generator-maven-plugin.version>7.24.0</openapi-generator-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>de.muenchen.oss.eakte</groupId>
      <artifactId>eakte-api-v2-spec</artifactId>
      <version>${project.version}</version>
      <type>zip</type>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>${jackson-databind-nullable.version}</version>
    </dependency>
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
      <version>${swagger-annotation.version}</version>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- get the content of the open-api-spec artifact: -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${maven-dependency-plugin.version}</version>
        <executions>
          <execution>
            <id>unpack-dependencies</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <excludeGroupIds>*</excludeGroupIds>
              <excludeArtifactIds>*</excludeArtifactIds>
              <includeGroupIds>de.muenchen.oss.eakte</includeGroupIds>
              <includeArtifactIds>eakte-api-v2-spec</includeArtifactIds>
              <includes>**/*.yaml</includes>
              <outputDirectory>${project.build.directory}/unpacked-dependencies</outputDirectory>
              <overWriteReleases>false</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>api-gen-java-spring-server</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <!--See https://github.com/OpenAPITools/openapi-generator/tree/master/modules/openapi-generator-maven-plugin#general-configuration-parameters -->
              <inputSpec>${project.build.directory}/unpacked-dependencies/eakte-rest-api-v2/__ServiceDefinition.yaml</inputSpec>
<!--              <output>${project.basedir}/src-generated</output>-->

              <generatorName>spring</generatorName>
              <apiPackage>de.muenchen.oss.eakte.schnittstelle.rest_v2.server_stubs.controllers</apiPackage>
              <modelPackage>de.muenchen.oss.eakte.schnittstelle.rest_v2.server_stubs.model</modelPackage>
              <invokerPackage>de.muenchen.oss.eakte.schnittstelle.rest_v2.server_stubs.invokers</invokerPackage>

              <configOptions>
                <!-- See https://openapi-generator.tech/docs/generators/spring/#config-options -->
                <useSpringBoot4>true</useSpringBoot4>
                <useSpringController>true</useSpringController>
                <!-- <useOneOfInterfaces>true</useOneOfInterfaces> -->
                <interfaceOnly>true</interfaceOnly>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <useOptional>true</useOptional>
                <includeHttpRequestContext>true</includeHttpRequestContext>
                <useTags>true</useTags>
                <generateBuilders>true</generateBuilders>
              </configOptions>
              <globalProperties>
                <!-- generator problem with $ref vs. inlining:
                     see https://github.com/OpenAPITools/openapi-generator/issues/10415
                     and https://github.com/OpenAPITools/openapi-generator/issues/14976
                -->
                <!-- <skipFormModel>false</skipFormModel>-->
              </globalProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
