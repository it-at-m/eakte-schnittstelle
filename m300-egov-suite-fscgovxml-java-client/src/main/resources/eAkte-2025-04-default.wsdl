                    <xsd:element name="DATE" type="tns:DATEType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="CONTENT" type="tns:CONTENTType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="ENUM" type="tns:ENUMType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="OBJECT" type="tns:OBJECTPointerType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="AGGREGATE" type="tns:AGGREGATEType" minOccurs="0" maxOccurs="unbounded"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:attributeGroup name="ValueIdentifierGroup">
                <xsd:attribute name="reference" type="xsd:string" use="optional" form="qualified"/>
                <xsd:attribute name="index" type="xsd:integer" use="optional" form="qualified"/>
            </xsd:attributeGroup>
            <xsd:complexType name="BOOLEANType">
                <xsd:simpleContent>
                    <xsd:extension base="xsd:boolean">
                        <xsd:attributeGroup ref="tns:ValueIdentifierGroup"/>
                    </xsd:extension>
                </xsd:simpleContent>
            </xsd:complexType>
            <xsd:complexType name="STRINGType">
                <xsd:simpleContent>
                    <xsd:extension base="xsd:string">
                        <xsd:attributeGroup ref="tns:ValueIdentifierGroup"/>
                    </xsd:extension>
                </xsd:simpleContent>
            </xsd:complexType>
            <xsd:complexType name="INTEGERType">
                <xsd:simpleContent>
                    <xsd:extension base="xsd:integer">
                        <xsd:attributeGroup ref="tns:ValueIdentifierGroup"/>
                    </xsd:extension>
                </xsd:simpleContent>
            </xsd:complexType>
            <xsd:complexType name="FLOATType">
                <xsd:simpleContent>
                    <xsd:extension base="xsd:float">
                        <xsd:attributeGroup ref="tns:ValueIdentifierGroup"/>
                    </xsd:extension>
                </xsd:simpleContent>
            </xsd:complexType>
            <xsd:complexType name="CONTENTType">
                <xsd:simpleContent>
                    <xsd:extension base="xsd:base64Binary">
                        <xsd:attributeGroup ref="tns:ValueIdentifierGroup"/>
                    </xsd:extension>
                </xsd:simpleContent>
            </xsd:complexType>
            <xsd:complexType name="OBJECTPointerType">
                <xsd:simpleContent>
                    <xsd:extension base="xsd:string">
                        <xsd:attributeGroup ref="tns:ValueIdentifierGroup"/>
                    </xsd:extension>
                </xsd:simpleContent>
            </xsd:complexType>
            <xsd:complexType name="DATETIMEType">
                <xsd:simpleContent>
                    <xsd:extension base="xsd:dateTime">
                        <xsd:attributeGroup ref="tns:ValueIdentifierGroup"/>
                    </xsd:extension>
                </xsd:simpleContent>
            </xsd:complexType>
            <xsd:complexType name="DATEType">
                <xsd:simpleContent>
                    <xsd:extension base="xsd:date">
                        <xsd:attributeGroup ref="tns:ValueIdentifierGroup"/>
                    </xsd:extension>
                </xsd:simpleContent>
            </xsd:complexType>
            <xsd:complexType name="ENUMType">
                <xsd:simpleContent>
                    <xsd:extension base="xsd:integer">
                        <xsd:attributeGroup ref="tns:ValueIdentifierGroup"/>
                    </xsd:extension>
                </xsd:simpleContent>
            </xsd:complexType>
            <xsd:complexType name="AGGREGATELineType">
                <xsd:sequence>
                    <xsd:element name="BOOLEAN" type="tns:BOOLEANType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="STRING" type="tns:STRINGType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="FLOAT" type="tns:FLOATType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="INTEGER" type="tns:INTEGERType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="CONTENT" type="tns:CONTENTType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="OBJECT" type="tns:OBJECTPointerType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="DATETIME" type="tns:DATETIMEType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="DATE" type="tns:DATEType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="ENUM" type="tns:ENUMType" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="AGGREGATE" type="tns:AGGREGATEType" minOccurs="0" maxOccurs="unbounded"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="AGGREGATEType">
                <xsd:complexContent>
                    <xsd:extension base="tns:AGGREGATELineType">
                        <xsd:attributeGroup ref="tns:ValueIdentifierGroup"/>
                    </xsd:extension>
                </xsd:complexContent>
            </xsd:complexType>
