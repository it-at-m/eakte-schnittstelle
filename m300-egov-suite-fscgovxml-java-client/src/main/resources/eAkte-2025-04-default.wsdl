        <xsd:schema targetNamespace="urn:schemas-fabasoft-com:bai:search" elementFormDefault="qualified" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:dt="urn:schemas-microsoft-com:datatypes" xmlns:tns="urn:schemas-fabasoft-com:bai:search">
